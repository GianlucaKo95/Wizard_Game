# Kopieren nach .env (wird von Vite automatisch geladen, siehe .gitignore) und
# mit den Werten deines Supabase-Projekts befüllen (Projekteinstellungen ->
# API). Alle drei Variablen werden zur Build-Zeit von Vite in das Bundle
# eingebettet - siehe wizard/frontend/src/supabase.ts.

# Projekt-URL, z.B. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Der öffentliche "anon"-Key des Projekts (NICHT der service_role-Key!) -
# Row Level Security schützt die Daten, dieser Key darf öffentlich sein.
VITE_SUPABASE_ANON_KEY=

# Optional: öffentlicher VAPID-Schlüssel für Web-Push-Benachrichtigungen
# ("Du bist dran"). Ohne diese Variable wird die Push-Option im Profil
# einfach nicht angezeigt (siehe App.tsx, pushSupported). Muss zum privaten
# VAPID_PRIVATE_KEY-Secret der Edge Function passen (siehe docs/DEVELOPMENT.md).
VITE_VAPID_PUBLIC_KEY=
